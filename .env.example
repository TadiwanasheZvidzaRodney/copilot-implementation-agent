# Hugging Face API Token (Get one free at https://huggingface.co/settings/tokens)
# Nuxt 3 requires NUXT_ prefix for runtime config mapping
NUXT_HF_TOKEN=your_huggingface_access_token

# Supabase Configuration (Optional - for cloud sync)
# Get from https://supabase.com/dashboard/project/_/settings/api
NUXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NUXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
